{
  "name": "teardown",
  "version": "1.0.0",
  "private": true,
  "description": "A Claude Code skill that builds interactive 3D simulators of real machines and records them to 60 fps video.",
  "license": "MIT",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "build": "node sims/build.mjs",
    "build:web": "node web/build.mjs",
    "start:web": "node web/server.mjs",
    "test:web": "node --test web/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.28.1",
    "lucide-react": "^0.577.0",
    "playwright": "1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "three": "0.186.1"
  }
}
